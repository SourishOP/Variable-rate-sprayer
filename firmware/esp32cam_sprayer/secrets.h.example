// Copy this file to secrets.h (same folder) and fill in your own values.
// secrets.h is git-ignored so credentials are never committed.

// Wi-Fi the ESP32-CAM joins (a phone hotspot works; 2.4 GHz only).
#define WIFI_SSID        "YOUR_WIFI_SSID"
#define WIFI_PASSWORD    "YOUR_WIFI_PASSWORD"

// /predict endpoint of the machine running app/server.py, reachable from the
// ESP32 (use that machine's LAN/hotspot IP, not localhost).
#define PREDICT_URL      "http://192.168.0.100:5000/predict"

// Blynk (only used when BLYNK_ENABLED is 1 in esp32cam_sprayer.ino).
// See ../BLYNK_SETUP.md.
#define BLYNK_TEMPLATE_ID   "YOUR_BLYNK_TEMPLATE_ID"
#define BLYNK_TEMPLATE_NAME "PaddyGuard"
#define BLYNK_AUTH_TOKEN    "YOUR_BLYNK_AUTH_TOKEN"